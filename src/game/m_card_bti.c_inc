#ifdef __INTELLISENSE__
#include "m_card.h"
#include "libultra/libultra.h"
#include "jsyswrap.h"
#include "m_malloc.h"
#endif

static u8* mCD_set_bti_data(u8* data, int res_fileNo, int tlut_size, int count, int pal_size, int random) {
    u32 addr = JW_GetAramAddress(res_fileNo);
    u32 size = ALIGN_NEXT(JW_GetResSizeFileNo(res_fileNo), 32);
#ifdef TARGET_PC
    /* The palette is copied whole (pal_size) even where the resource has
     * fewer colors, which read past the buffer; give it zeros to read */
    CResTIMG* buf = (CResTIMG*)mCD_malloc_32(size + pal_size);
#else
    CResTIMG* buf = (CResTIMG*)mCD_malloc_32(size);
#endif
    int idx;

    if (buf != NULL) {
        u8* tex_p;
        u16* pal_p;
        
#ifdef TARGET_PC
        bzero(buf, size + pal_size);
#endif
        _JW_GetResourceAram(addr, (u8*)buf, size);
        DCStoreRangeNoSync(buf, size);
#ifdef TARGET_PC
        /* the resource is the disc's big-endian BTI */
        tex_p = (u8*)(buf) + pc_bswap32(buf->mImageDataOffset);
#else
        tex_p = (u8*)(buf) + buf->mImageDataOffset;
#endif
        idx = random ? RANDOM(count) : count;
        
        while (TRUE) {
            u8* dst;

            count--;
            if (random != FALSE) {
                if (count == idx) {
                    dst = tex_p + tlut_size;
                } else {
                    dst = tex_p;
                }
            } else {
                dst = tex_p;
                tex_p += tlut_size;
            }

            bcopy(dst, data, tlut_size);
            data += tlut_size;
            if (count == 0) {
                break;
            }
        }

#ifdef TARGET_PC
        pal_p = (u16*)((u8*)(buf) + pc_bswap32(buf->mPaletteOffset));
#else
        pal_p = (u16*)((u8*)(buf) + buf->mPaletteOffset);
#endif
        bcopy(pal_p, data, pal_size);
        data += pal_size;
        zelda_free(buf);
    }

    return data;
}
