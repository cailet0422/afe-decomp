/* ac_npc_pc_mp.c_inc - the port's multiplayer (pc_mp_game.c), TARGET_PC only
 *
 * The host's villagers lead: the host reports each resident villager's
 * position, facing and walk/run/stand a few times a second, and on a guest
 * in the host's town the same villager follows it with its own walk action
 * (so it animates as it walks) while it is wandering. Greetings, going
 * home, sleeping and the like stay each player's own. A talk is shown to the
 * others: the villager stops there, facing the one it talks with, in its talk
 * pose (the host's when a guest talks with it, so everyone's). */

#define aNPC_PC_MP_HIDDEN (1 << 0)  /* inside its house (hidden) */
#define aNPC_PC_MP_AT_HOME (1 << 1) /* Animal_c is_home */
#define aNPC_PC_MP_FREE (1 << 2)    /* wandering: others may follow it */
#define aNPC_PC_MP_TALK (1 << 3)    /* in a talk (with its player, or held by another's) */

enum {
    aNPC_PC_MP_STAND,
    aNPC_PC_MP_WALK,
    aNPC_PC_MP_RUN,
    aNPC_PC_MP_BUSY, /* greeting, talking, catching... */
};

#ifdef aNPC_NPC2
/* in its house (the indoor controller): room coordinates, a message of their own */
#define pc_mp_npc_report pc_mp_npc_room_report
#define pc_mp_npc_target pc_mp_npc_room_target
#endif
extern void pc_mp_npc_report(int idx, mActor_name_t npc_id, f32 x, f32 y, f32 z, s16 angle, int act, int flags);
extern int pc_mp_npc_target(int idx, mActor_name_t npc_id, f32* x, f32* y, f32* z, s16* angle, int* act, int* flags);
/* this game's player talks with it (or not), where it stands */
extern void pc_mp_npc_talking(int idx, mActor_name_t npc_id, int talking, f32 x, f32 y, f32 z);
/* another player talks with it: where it stands in that player's game, and
 * which way to face there (toward that player) */
extern int pc_mp_npc_talk_hold(int idx, mActor_name_t npc_id, f32* x, f32* y, f32* z, s16* angle);

static int aNPC_pc_mp_index(NPC_ACTOR* nactorx, mActor_name_t* npc_id) {
    int idx;

    if (nactorx->actor_class.id != mAc_PROFILE_NORMAL_NPC || nactorx->npc_info.list == NULL ||
        nactorx->npc_info.animal == NULL) {
        return -1;
    }
    idx = (int)(nactorx->npc_info.list - Common_Get(npclist));
    if (idx < 0 || idx >= ANIMAL_NUM_MAX) {
        return -1;
    }
    *npc_id = nactorx->npc_info.animal->id.npc_id;
    return idx;
}

/* wandering, nothing of its own going on */
static int aNPC_pc_mp_free(NPC_ACTOR* nactorx) {
    if (nactorx->condition_info.talk_condition != aNPC_TALK_TYPE_NONE ||
        mDemo_Get_talk_actor() == (ACTOR*)nactorx || mDemo_IS_ANY_TALK_DEMO((ACTOR*)nactorx) ||
        nactorx->think.force_call_flag != aNPC_FORCE_CALL_NONE || nactorx->condition_info.hide_flg ||
        nactorx->condition_info.hide_request || nactorx->condition_info.pitfall_flag ||
#ifdef aNPC_NPC2
        /* walking about its room (not coming in, going out or hidden) */
        nactorx->schedule.type != aNPC_SCHEDULE_TYPE_IN_HOUSE ||
        nactorx->schedule.step != aNPC_SCHEDULE_IN_HOUSE_STEP_WANDER || nactorx->think.idx != aNPC_THINK_WANDER) {
#else
        nactorx->schedule.type != aNPC_SCHEDULE_TYPE_FIELD ||
        (nactorx->think.idx != aNPC_THINK_WANDER && nactorx->think.idx != aNPC_THINK_WALK_WANDER)) {
#endif
        return FALSE;
    }
    if (nactorx->action.step != aNPC_ACTION_END_STEP) {
        switch (nactorx->action.idx) {
            case aNPC_ACT_WAIT:
            case aNPC_ACT_WALK:
            case aNPC_ACT_RUN:
            case aNPC_ACT_TURN:
            case aNPC_ACT_TURN2:
                break;
            default:
                return FALSE;
        }
    }
    return TRUE;
}

/* in a talk with this game's player */
static int aNPC_pc_mp_talking_here(NPC_ACTOR* nactorx) {
    return mDemo_Get_talk_actor() == (ACTOR*)nactorx;
}

/* another's talk shown: stopped, facing, in the pose of a talk (the talk
 * action's own animation, without the talk) */
static void aNPC_pc_mp_talk_pose(NPC_ACTOR* nactorx) {
    if (nactorx->action.idx == aNPC_ACT_WAIT && nactorx->action.step != aNPC_ACTION_END_STEP &&
        nactorx->condition_info.action != aNPC_ACTION_TYPE_TALK) {
        aNPC_setupAction(nactorx, aNPC_ACTION_TYPE_TALK);
    }
}

/* another player talks with it here: it goes where it stands in that
 * player's game (there at once when far or out of sight) and stands there,
 * turned to them */
static int aNPC_pc_mp_hold(NPC_ACTOR* nactorx, int idx, mActor_name_t npc_id) {
    ACTOR* actorx = (ACTOR*)nactorx;
    f32 x, y, z, dx, dz, d2;
    s16 angle;

    if (aNPC_pc_mp_talking_here(nactorx) || !aNPC_pc_mp_free(nactorx) ||
        !pc_mp_npc_talk_hold(idx, npc_id, &x, &y, &z, &angle)) {
        return FALSE;
    }
    dx = x - actorx->world.position.x;
    dz = z - actorx->world.position.z;
    d2 = dx * dx + dz * dz;
    if (d2 > 400.0f * 400.0f || (d2 > 100.0f * 100.0f && (actorx->state_bitfield & ACTOR_STATE_NO_CULL) == 0)) {
        actorx->world.position.x = x;
        actorx->world.position.y = y;
        actorx->world.position.z = z;
        actorx->last_world_position = actorx->world.position;
        d2 = 0.0f;
    }
    if (d2 > 16.0f * 16.0f) {
        u16 args[6];

        args[0] = 0;
        args[1] = 0;
        args[2] = (u16)(s16)x;
        args[3] = (u16)(s16)z;
        args[4] = 0;
        args[5] = 0;
        aNPC_set_request_act(nactorx, 3, aNPC_ACT_WALK, aNPC_ACT_TYPE_TO_POINT, args);
    } else {
        aNPC_set_request_act(nactorx, 3, aNPC_ACT_WAIT, aNPC_ACT_TYPE_DEFAULT, aNPC_req_default_data);
        nactorx->movement.mv_angl = angle;
        aNPC_pc_mp_talk_pose(nactorx);
    }
    return TRUE;
}

/* the host: this villager's state after its move */
static void aNPC_pc_mp_report(NPC_ACTOR* nactorx) {
    mActor_name_t npc_id;
    int idx = aNPC_pc_mp_index(nactorx, &npc_id);
    int act;
    int flags = 0;
    int talking;
    f32 hold_x, hold_y, hold_z;
    s16 hold_angle;

    if (idx < 0) {
        return;
    }
    talking = aNPC_pc_mp_talking_here(nactorx);
    pc_mp_npc_talking(idx, npc_id, talking, nactorx->actor_class.world.position.x,
                      nactorx->actor_class.world.position.y, nactorx->actor_class.world.position.z);
    switch (nactorx->action.step == aNPC_ACTION_END_STEP ? aNPC_ACT_WAIT : nactorx->action.idx) {
        case aNPC_ACT_WAIT:
        case aNPC_ACT_TURN:
        case aNPC_ACT_TURN2:
            act = aNPC_PC_MP_STAND;
            break;
        case aNPC_ACT_WALK:
            act = aNPC_PC_MP_WALK;
            break;
        case aNPC_ACT_RUN:
            act = aNPC_PC_MP_RUN;
            break;
        default:
            act = aNPC_PC_MP_BUSY;
            break;
    }
    if (nactorx->condition_info.hide_flg) {
        flags |= aNPC_PC_MP_HIDDEN;
    }
    if (nactorx->npc_info.animal->is_home) {
        flags |= aNPC_PC_MP_AT_HOME;
    }
    if (aNPC_pc_mp_free(nactorx)) {
        flags |= aNPC_PC_MP_FREE;
    }
    if (talking || pc_mp_npc_talk_hold(idx, npc_id, &hold_x, &hold_y, &hold_z, &hold_angle)) {
        flags |= aNPC_PC_MP_TALK;
        act = aNPC_PC_MP_STAND;
    }
    pc_mp_npc_report(idx, npc_id, nactorx->actor_class.world.position.x, nactorx->actor_class.world.position.y,
                     nactorx->actor_class.world.position.z, nactorx->actor_class.shape_info.rotation.y, act, flags);
}

/* a guest: after its own think, walk where the host's one is (a request of
 * priority 3: above wandering, below talking and greeting) */
static void aNPC_pc_mp_follow(NPC_ACTOR* nactorx, GAME_PLAY* play) {
    ACTOR* actorx = (ACTOR*)nactorx;
    mActor_name_t npc_id;
    int idx = aNPC_pc_mp_index(nactorx, &npc_id);
    f32 x, y, z, dx, dz, d2;
    s16 angle;
    int act, flags;

    if (idx < 0 || aNPC_pc_mp_hold(nactorx, idx, npc_id) ||
        !pc_mp_npc_target(idx, npc_id, &x, &y, &z, &angle, &act, &flags)) {
        return;
    }
    if ((flags & aNPC_PC_MP_HIDDEN) || !aNPC_pc_mp_free(nactorx)) {
        return; /* (going home, talking...: its own) */
    }
#ifndef aNPC_NPC2
    nactorx->palActorIgnoreTimer = -1; /* no greetings among themselves */
    /* (not into its own door on the way, nor kept to its circle) */
    nactorx->condition_info.demo_flg |= aNPC_COND_DEMO_SKIP_MOVE_CIRCLE_REV | aNPC_COND_DEMO_SKIP_MOVE_RANGE_CHECK |
                                        aNPC_COND_DEMO_SKIP_ENTRANCE_CHECK;
#endif

    dx = x - actorx->world.position.x;
    dz = z - actorx->world.position.z;
    d2 = dx * dx + dz * dz;
#ifdef aNPC_NPC2
    /* a room is small: far off only on coming in (a random place) or after a talk */
    if (d2 > 120.0f * 120.0f) {
#else
    if (d2 > 400.0f * 400.0f || (d2 > 160.0f * 160.0f && (actorx->state_bitfield & ACTOR_STATE_NO_CULL) == 0)) {
#endif
        /* far off (a talk, a spawn): there at once, best while out of sight */
        actorx->world.position.x = x;
        actorx->world.position.y = y;
        actorx->world.position.z = z;
        actorx->last_world_position = actorx->world.position;
        actorx->shape_info.rotation.y = angle;
        actorx->world.angle.y = angle;
        nactorx->movement.mv_angl = angle;
        dx = dz = d2 = 0.0f;
    }

    /* (in a talk: right where the host's stands, for the one it talks with) */
    if (act == aNPC_PC_MP_WALK || act == aNPC_PC_MP_RUN ||
        d2 > ((flags & aNPC_PC_MP_TALK) ? 10.0f * 10.0f : 24.0f * 24.0f)) {
        u16 args[6];

        args[0] = 0;
        args[1] = 0;
        args[2] = (u16)(s16)x;
        args[3] = (u16)(s16)z;
        args[4] = 0;
        args[5] = 0;
        aNPC_set_request_act(nactorx, 3, (act == aNPC_PC_MP_RUN || d2 > 120.0f * 120.0f) ? aNPC_ACT_RUN : aNPC_ACT_WALK,
                             aNPC_ACT_TYPE_TO_POINT, args);
    } else {
        aNPC_set_request_act(nactorx, 3, aNPC_ACT_WAIT, aNPC_ACT_TYPE_DEFAULT, aNPC_req_default_data);
        nactorx->movement.mv_angl = angle;
        if (flags & aNPC_PC_MP_TALK) {
            aNPC_pc_mp_talk_pose(nactorx); /* (talking with the host, or with another guest) */
        }
    }
    (void)play;
}

#ifdef aNPC_NPC2
/* a guest: the host's villager is in its room (not hidden), in the house
 * this player is in */
static int aNPC_pc_mp_room_shown(NPC_ACTOR* nactorx) {
    mActor_name_t npc_id;
    int idx = aNPC_pc_mp_index(nactorx, &npc_id);
    f32 x, y, z;
    s16 angle;
    int act, flags;

    return idx >= 0 && pc_mp_npc_target(idx, npc_id, &x, &y, &z, &angle, &act, &flags) &&
           !(flags & aNPC_PC_MP_HIDDEN);
}
#endif
